# FRAYWICK server settings. On the VPS these live in /etc/fraywick/*.env (see STATUS-SERVER.md); never commit real values.
# --- /etc/fraywick/fraywick.env (root:fraywick 0640, no secrets)
PUBLIC_URL=https://fraywick.xyz
DRY_POST=1
# ANCHOR_ADDRESS=0x...          # else contracts/deployments/robinhood.json
# RPC_URL=https://robinhood-rpc.publicnode.com
# CONCURRENCY=16
# HOST_SPACING_MS=1000
# HOST_MAX_PER_EPOCH=240
# PACKAGE_CONCURRENCY=8
# CHECK_HTTP_ALLOW=
# --- /etc/fraywick/poster.env (root:root 0600)
POSTER_PRIVATE_KEY=
# --- /etc/fraywick/github.env (root:root 0600, optional)
GITHUB_TOKEN=
# --- local only
# PORT=4891  ROLE=all|api|crawler  DATA_DIR=./data  SERVE_WEB=1  DB=memory  NO_NETWORK=1
